+    /// Refuse a pending VT release (VT_RELDISP with 0). The switch is cancelled
+    /// and this VT stays active. Used while an external program owns the display.
+    pub fn refuse_release(&mut self) -> Result<()> {
+        let ret = unsafe { libc::ioctl(self.tty_fd, VT_RELDISP, 0 as libc::c_int) };
+        if ret < 0 {
+            return Err(anyhow!(
+                "VT_RELDISP(0) failed: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        Ok(())
+    }
+
+    /// Re-assert process-controlled VT mode and KD_GRAPHICS. A program that took
+    /// over the display (Qt's VT handler, for one) may have changed either.
+    pub fn reassert(&mut self) {
+        let mode = VtMode {
+            mode: VT_PROCESS,
+            waitv: 0,
+            relsig: Signal::SIGUSR2 as libc::c_short,
+            acqsig: Signal::SIGUSR1 as libc::c_short,
+            frsig: 0,
+        };
+        unsafe {
+            libc::ioctl(self.tty_fd, VT_SETMODE, &mode);
+            libc::ioctl(self.tty_fd, KDSETMODE, KD_GRAPHICS);
+            libc::tcflush(self.tty_fd, libc::TCIFLUSH);
+        }
+        self.active = true;
+    }
