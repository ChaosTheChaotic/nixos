diff -ruN a/src/handoff.rs b/src/handoff.rs
--- a/src/handoff.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/src/handoff.rs	2026-11-17 21:41:41.672336707 +0000
@@ -0,0 +1,461 @@
+//! Display hand-off: let an external program own the display, then take it back.
+//!
+//! Server side lives in bcon, client side is `bcon handoff [opts] -- CMD ARGS...`.
+//!
+//! Protocol over /run/bcon/handoff-ttyN.sock (one line each way):
+//!   client -> bcon   BEGIN <kms|fb> <pty|none> <stop-keys|->
+//!   bcon   -> client OK | ERR <reason>      (sent once the display is released)
+//!   bcon   -> client STOP                   (a stop key was pressed; client stops CMD)
+//!   client runs CMD, then sends END (or simply exits / dies: EOF counts as END)
+//!
+//! STOP is handled by the client, which owns CMD and runs as the user. bcon itself
+//! runs hardened (no CAP_KILL) and cannot signal the user's processes.
+//!
+//! `kms`: bcon drops DRM master, so CMD can become master (mpv --gpu-context=drm,
+//!        Qt eglfs_kms, SDL kmsdrm, ...). Needs the VT backend (root).
+//! `fb` : bcon keeps master but puts the boot framebuffer (the fbdev emulation
+//!        buffer behind /dev/fb0) back on the CRTC, so CMD can draw to /dev/fb0.
+//!
+//! While a hand-off is active bcon does not render or modeset. It keeps draining
+//! every PTY (CMD's stdout would otherwise block) and reading input, which is
+//! forwarded to the PTY (`pty`) or dropped (`none`).
+
+use std::io::{self, BufRead, BufReader, Read, Write};
+use std::os::unix::fs::PermissionsExt;
+use std::os::unix::io::{AsRawFd, RawFd};
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::os::unix::process::ExitStatusExt;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::time::{Duration, Instant};
+
+use anyhow::{anyhow, bail, Context, Result};
+use log::{debug, warn};
+
+const SOCK_DIR: &str = "/run/bcon";
+
+// evdev keycodes (linux/input-event-codes.h)
+const KEY_ESC: u32 = 1;
+const KEY_BACKSPACE: u32 = 14;
+const KEY_Q: u32 = 16;
+
+pub fn socket_path(vt: u16) -> PathBuf {
+    Path::new(SOCK_DIR).join(format!("handoff-tty{}.sock", vt))
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum HandoffMode {
+    Kms,
+    Fb,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum InputMode {
+    Pty,
+    None,
+}
+
+fn parse_stop_keys(s: &str) -> Vec<u32> {
+    s.split(',')
+        .filter_map(|k| match k.trim().to_ascii_lowercase().as_str() {
+            "q" => Some(KEY_Q),
+            "esc" | "escape" => Some(KEY_ESC),
+            _ => None,
+        })
+        .collect()
+}
+
+fn peer_cred(stream: &UnixStream) -> io::Result<libc::ucred> {
+    let mut cred = libc::ucred {
+        pid: 0,
+        uid: 0,
+        gid: 0,
+    };
+    let mut len = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    let ret = unsafe {
+        libc::getsockopt(
+            stream.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            &mut cred as *mut _ as *mut libc::c_void,
+            &mut len,
+        )
+    };
+    if ret < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(cred)
+    }
+}
+
+/// Hide the hardware cursor plane (needs DRM master). Otherwise the pointer image
+/// can stay on top of whatever the other program draws.
+pub fn hide_hw_cursor(drm_fd: RawFd, crtc_id: u32) {
+    #[repr(C)]
+    struct DrmModeCursor {
+        flags: u32,
+        crtc_id: u32,
+        x: i32,
+        y: i32,
+        width: u32,
+        height: u32,
+        handle: u32,
+    }
+    const DRM_MODE_CURSOR_BO: u32 = 0x01;
+    // DRM_IOCTL_MODE_CURSOR = DRM_IOWR(0xA3, struct drm_mode_cursor)
+    let req = nix::request_code_readwrite!(0x64, 0xA3, std::mem::size_of::<DrmModeCursor>())
+        as libc::c_ulong;
+    let mut c = DrmModeCursor {
+        flags: DRM_MODE_CURSOR_BO,
+        crtc_id,
+        x: 0,
+        y: 0,
+        width: 0,
+        height: 0,
+        handle: 0, // handle 0 + CURSOR_BO = disable the cursor
+    };
+    let ret = unsafe { libc::ioctl(drm_fd, req, &mut c as *mut _) };
+    if ret < 0 {
+        debug!(
+            "handoff: hiding hw cursor failed: {}",
+            io::Error::last_os_error()
+        );
+    }
+}
+
+// ============================================================================
+// Server (inside bcon)
+// ============================================================================
+
+pub struct HandoffServer {
+    listener: UnixListener,
+    path: PathBuf,
+}
+
+impl HandoffServer {
+    pub fn bind(vt: u16) -> io::Result<Self> {
+        std::fs::create_dir_all(SOCK_DIR)?;
+        let path = socket_path(vt);
+        let _ = std::fs::remove_file(&path);
+        let listener = UnixListener::bind(&path)?;
+        // Peer credentials are checked per request, so any local user may connect.
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o666))?;
+        listener.set_nonblocking(true)?;
+        Ok(Self { listener, path })
+    }
+
+    /// Non-blocking. Returns a validated BEGIN request if one is waiting.
+    /// `allowed_uid` is the user logged in on the active pane (root is always allowed).
+    pub fn poll(&self, allowed_uid: Option<u32>) -> Option<Request> {
+        let (stream, _) = match self.listener.accept() {
+            Ok(s) => s,
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => return None,
+            Err(e) => {
+                warn!("handoff: accept failed: {}", e);
+                return None;
+            }
+        };
+        match Request::read(stream, allowed_uid) {
+            Ok(r) => Some(r),
+            Err(e) => {
+                warn!("handoff: rejected request: {:#}", e);
+                None
+            }
+        }
+    }
+}
+
+impl Drop for HandoffServer {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
+
+pub struct Request {
+    stream: UnixStream,
+    pub pid: i32,
+    pgid: i32,
+    pub mode: HandoffMode,
+    pub input: InputMode,
+    stop_keys: Vec<u32>,
+}
+
+impl Request {
+    fn read(stream: UnixStream, allowed_uid: Option<u32>) -> Result<Self> {
+        stream.set_nonblocking(false)?;
+        stream.set_read_timeout(Some(Duration::from_millis(500)))?;
+
+        let cred = peer_cred(&stream).context("SO_PEERCRED failed")?;
+        if cred.uid != 0 && Some(cred.uid) != allowed_uid {
+            let mut s = &stream;
+            let _ = s.write_all(b"ERR not permitted\n");
+            bail!("uid {} is not allowed to take the display", cred.uid);
+        }
+
+        let mut line = String::new();
+        BufReader::new((&stream).take(256)).read_line(&mut line)?;
+        let mut it = line.split_whitespace();
+        if it.next() != Some("BEGIN") {
+            bail!("expected BEGIN, got {:?}", line.trim());
+        }
+        let mode = match it.next() {
+            Some("kms") => HandoffMode::Kms,
+            Some("fb") => HandoffMode::Fb,
+            other => bail!("bad mode {:?}", other),
+        };
+        let input = match it.next() {
+            Some("pty") => InputMode::Pty,
+            Some("none") => InputMode::None,
+            other => bail!("bad input mode {:?}", other),
+        };
+        let stop_keys = match it.next() {
+            Some("-") | None => Vec::new(),
+            Some(list) => parse_stop_keys(list),
+        };
+
+        // The kernel, not the client, says who is on the other end.
+        let pgid = unsafe { libc::getpgid(cred.pid) };
+
+        Ok(Self {
+            stream,
+            pid: cred.pid,
+            pgid,
+            mode,
+            input,
+            stop_keys,
+        })
+    }
+
+    pub fn reject(mut self, why: &str) {
+        let _ = writeln!(self.stream, "ERR {}", why);
+    }
+
+    /// Tell the client it may go ahead (display already released).
+    pub fn accept(mut self) -> io::Result<ActiveHandoff> {
+        self.stream.write_all(b"OK\n")?;
+        self.stream.set_read_timeout(None)?;
+        self.stream.set_nonblocking(true)?;
+        Ok(ActiveHandoff {
+            stream: self.stream,
+            pgid: self.pgid,
+            pid: self.pid,
+            input: self.input,
+            stop_keys: self.stop_keys,
+            ended_at: None,
+            stop_sent: false,
+            term_sent: false,
+            kill_sent: false,
+        })
+    }
+}
+
+pub struct ActiveHandoff {
+    stream: UnixStream,
+    pgid: i32,
+    pub pid: i32,
+    pub input: InputMode,
+    stop_keys: Vec<u32>,
+    ended_at: Option<Instant>,
+    stop_sent: bool,
+    term_sent: bool,
+    kill_sent: bool,
+}
+
+impl ActiveHandoff {
+    /// True once the client said END, exited, or died (a dead process closes its
+    /// socket, so even SIGKILL ends up here).
+    pub fn poll_client(&mut self) -> bool {
+        if self.ended_at.is_some() {
+            return true;
+        }
+        let mut buf = [0u8; 64];
+        match self.stream.read(&mut buf) {
+            Ok(0) => {
+                self.ended_at = Some(Instant::now());
+                true
+            }
+            Ok(n) if buf[..n].starts_with(b"END") => {
+                self.ended_at = Some(Instant::now());
+                true
+            }
+            Ok(_) => false,
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => false,
+            Err(_) => {
+                self.ended_at = Some(Instant::now());
+                true
+            }
+        }
+    }
+
+    /// Ctrl+Alt+Backspace always stops the program; `--stop-keys` adds plain keys.
+    pub fn is_stop_key(&self, keycode: u32, ctrl: bool, alt: bool) -> bool {
+        if ctrl && alt && keycode == KEY_BACKSPACE {
+            return true;
+        }
+        !ctrl && !alt && self.stop_keys.contains(&keycode)
+    }
+
+    /// Ask the client to stop its program. Returns true the first time only.
+    pub fn request_stop(&mut self) -> bool {
+        if self.stop_sent {
+            return false;
+        }
+        self.stop_sent = true;
+        let mut s = &self.stream;
+        if let Err(e) = s.write_all(b"STOP\n") {
+            warn!("handoff: could not send STOP: {}", e);
+        }
+        true
+    }
+
+    /// Last resort: signal the client's whole process group. Only used when the
+    /// client is gone but the program still holds the display. Needs CAP_KILL, which
+    /// the bcon service may not have, so failures are reported instead of ignored.
+    pub fn signal_job(&self, sig: libc::c_int) {
+        let own = unsafe { libc::getpgrp() };
+        if self.pgid > 1 && self.pgid != own {
+            if unsafe { libc::killpg(self.pgid, sig) } != 0 {
+                warn!(
+                    "handoff: killpg({}, {}) failed: {} (the bcon service needs CAP_KILL for this)",
+                    self.pgid,
+                    sig,
+                    io::Error::last_os_error()
+                );
+            }
+        }
+    }
+
+    /// Called while retaking the display keeps failing: the program is still
+    /// holding DRM master. Escalate rather than leave the console dead.
+    pub fn escalate(&mut self) {
+        let elapsed = match self.ended_at {
+            Some(t) => t.elapsed(),
+            None => return,
+        };
+        if elapsed > Duration::from_secs(3) && !self.term_sent {
+            self.term_sent = true;
+            warn!("handoff: display not released after 3s, sending SIGTERM to the job");
+            self.signal_job(libc::SIGTERM);
+        }
+        if elapsed > Duration::from_secs(5) && !self.kill_sent {
+            self.kill_sent = true;
+            warn!("handoff: display not released after 5s, sending SIGKILL to the job");
+            self.signal_job(libc::SIGKILL);
+        }
+    }
+}
+
+// ============================================================================
+// Client (`bcon handoff ... -- CMD`)
+// ============================================================================
+
+pub fn run_client(args: &[String]) -> Result<i32> {
+    const USAGE: &str = "usage: bcon handoff [--mode kms|fb] [--input pty|none] \
+[--stop-keys q,esc] -- COMMAND [ARGS...]";
+
+    let mut mode = "kms";
+    let mut input = "pty";
+    let mut stop = String::from("-");
+    let mut i = 0;
+    while i < args.len() {
+        match args[i].as_str() {
+            "--mode" => {
+                i += 1;
+                mode = match args.get(i).map(String::as_str) {
+                    Some("kms") => "kms",
+                    Some("fb") => "fb",
+                    _ => bail!("--mode needs kms or fb\n{}", USAGE),
+                };
+            }
+            "--input" => {
+                i += 1;
+                input = match args.get(i).map(String::as_str) {
+                    Some("pty") => "pty",
+                    Some("none") => "none",
+                    _ => bail!("--input needs pty or none\n{}", USAGE),
+                };
+            }
+            "--stop-keys" => {
+                i += 1;
+                stop = args
+                    .get(i)
+                    .cloned()
+                    .ok_or_else(|| anyhow!("--stop-keys needs a list\n{}", USAGE))?;
+            }
+            "--" => {
+                i += 1;
+                break;
+            }
+            _ => break,
+        }
+        i += 1;
+    }
+    let cmd = &args[i.min(args.len())..];
+    if cmd.is_empty() {
+        bail!("{}", USAGE);
+    }
+
+    let sock = std::env::var_os("BCON_HANDOFF_SOCK")
+        .map(PathBuf::from)
+        .or_else(|| crate::drm::get_active_vt().map(socket_path))
+        .ok_or_else(|| anyhow!("cannot tell which VT is active"))?;
+    let mut stream = UnixStream::connect(&sock).with_context(|| {
+        format!(
+            "cannot connect to {} (is this a bcon with hand-off support, on the active VT?)",
+            sock.display()
+        )
+    })?;
+
+    writeln!(stream, "BEGIN {} {} {}", mode, input, stop)?;
+    stream.set_read_timeout(Some(Duration::from_secs(5)))?;
+    let mut reply = String::new();
+    BufReader::new(&stream).read_line(&mut reply)?;
+    let reply = reply.trim();
+    if reply != "OK" {
+        bail!(
+            "bcon refused the hand-off: {}",
+            reply.strip_prefix("ERR ").unwrap_or(reply)
+        );
+    }
+
+    let mut child = match Command::new(&cmd[0]).args(&cmd[1..]).spawn() {
+        Ok(c) => c,
+        Err(e) => {
+            let _ = stream.write_all(b"END\n");
+            bail!("cannot run {}: {}", cmd[0], e);
+        }
+    };
+
+    // bcon sends STOP when a stop key is pressed. We own the program and run as the
+    // user, so we stop it ourselves: SIGTERM first, SIGKILL if it ignores that.
+    let _ = stream.set_nonblocking(true);
+    let mut stop_at: Option<Instant> = None;
+    let mut killed = false;
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(st)) => break Ok(st),
+            Ok(None) => {}
+            Err(e) => break Err(e),
+        }
+        let mut buf = [0u8; 16];
+        if let Ok(n) = stream.read(&mut buf) {
+            if n > 0 && buf[..n].starts_with(b"STOP") && stop_at.is_none() {
+                stop_at = Some(Instant::now());
+                unsafe { libc::kill(child.id() as libc::pid_t, libc::SIGTERM) };
+            }
+        }
+        if let Some(t) = stop_at {
+            if !killed && t.elapsed() > Duration::from_secs(2) {
+                let _ = child.kill();
+                killed = true;
+            }
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    };
+
+    let _ = stream.write_all(b"END\n");
+    match status {
+        Ok(st) => Ok(st.code().unwrap_or_else(|| 128 + st.signal().unwrap_or(0))),
+        Err(e) => bail!("waiting for {} failed: {}", cmd[0], e),
+    }
+}
