+    /// Cell size of a virtual placement: c=/r= if given, otherwise derived from
+    /// the image size (aspect ratio kept when only one of them is given).
+    fn virtual_placement_cells(
+        pixel_width: u32,
+        pixel_height: u32,
+        cell_width: u32,
+        cell_height: u32,
+        cols: u32,
+        rows: u32,
