+        let cw = cell_width.max(1) as u64;
+        let ch = cell_height.max(1) as u64;
+        let (pw, ph) = (pixel_width as u64, pixel_height as u64);
+        let (c, r) = match (cols as u64, rows as u64) {
+            (0, 0) => ((pw + cw - 1) / cw, (ph + ch - 1) / ch),
+            (c, 0) if pw > 0 => (c, ((c * cw * ph + pw - 1) / pw + ch - 1) / ch),
+            (0, r) if ph > 0 => (((r * ch * pw + ph - 1) / ph + cw - 1) / cw, r),
+            (c, r) => (c, r),
+        };
+        (c.max(1) as usize, r.max(1) as usize)
+    }
