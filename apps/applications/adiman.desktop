[Desktop Entry]
Name=Adiman
Exec=bash -c 'nix develop "github:ChaosTheChaotic/Adiman/dev" -c $NIX_CFG_DIR/apps/adiman/Adiman.AppImage || nix develop "$HOME/Adiman" -c $NIX_CFG_DIR/apps/adiman/Adiman.AppImage'
Type=Application
Comment=Music player for linux inspired by Namida
Terminal=false
Icon=Adiman
Categories=AudioVideo;Audio;Music;Player;
