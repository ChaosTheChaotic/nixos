#!/usr/bin/env bash

source "$UTIL_SCRIPT_DIR/err.sh"

fmt_s() {
  local ts=$1
  if [[ "$ts" -le 0 ]]; then
    echo "N/A"
    return
  fi

  local h=$((ts / 3600))
  local m=$(((ts % 3600) / 60))
  local s=$((ts % 60))
  printf "%d:%02d:%02d" $h $m $s
}

CAPACITY_FILE="/sys/class/power_supply/macsmc-battery/capacity"
STATUS_FILE="/sys/class/power_supply/macsmc-battery/status"
TTE_FILE="/sys/class/power_supply/macsmc-battery/time_to_empty_now"
TTF_FILE="/sys/class/power_supply/macsmc-battery/time_to_full_now"

# Check if required files exist and are readable
if [[ ! -r "$CAPACITY_FILE" ]]; then
  fatal "Cannot read battery capacity file: $CAPACITY_FILE"
  exit 1
fi

if [[ ! -r "$STATUS_FILE" ]]; then
  fatal "Cannot read battery status file: $STATUS_FILE"
  exit 1
fi

POWER=$(cat "$CAPACITY_FILE" 2>/dev/null) || {
  fatal "Failed to read battery capacity"
  exit 1
}

STATE=$(cat "$STATUS_FILE" 2>/dev/null) || {
  fatal "Failed to read battery status"
  exit 1
}

echo "Capacity: $POWER%"
echo "Status: $STATE"

if [[ "$STATE" == "Discharging" ]]; then
  if [[ -r "$TTE_FILE" ]]; then
    T_S=$(cat "$TTE_FILE" 2>/dev/null)
    if [[ $? -eq 0 ]]; then
      FMT_T=$(fmt_s $T_S)
      echo "Estimated time until empty: $FMT_T"
    else
      warn "Could not read time to empty"
    fi
  else
    info "Time to empty information not available"
  fi
elif [[ "$STATE" == "Charging" ]]; then
  if [[ -r "$TTF_FILE" ]]; then
    T_S=$(cat "$TTF_FILE" 2>/dev/null)
    if [[ $? -eq 0 ]]; then
      FMT_T=$(fmt_s $T_S)
      echo "Estimated time until full: $FMT_T"
    else
      warn "Could not read time to full"
    fi
  else
    info "Time to full information not available"
  fi
fi
