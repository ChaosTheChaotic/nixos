#!/usr/bin/env bash

source "$UTIL_SCRIPT_DIR/err.sh"
source "$UTIL_SCRIPT_DIR/check_installed.sh"

read -d '' -r USAGE <<-EOF
Usage: screenshot [flags]
Capture screenshots

Options:
  -h  Show this help message
  -c  Write to clipboard with wl-copy
  -o  Write raw image data to stdout
  -s  Screenshot all outputs (default: select area)
  -n  Notify the user (requires notify-send)
  -d [DIR]  Write to specified directory or ~/Screenshots

At least one of -c, -o, or -d must be specified.
EOF

clip=false
full=false
noti=false
fs=false
stdout=false
od="$HOME/Screenshots"

parse_opts() {
  local OPTIND OPTARG opt

  while getopts 'hcosnd:' opt; do
    case "$opt" in
      c)
        clip=true
        ;;
      o)
        stdout=true
        ;;
      s)
        full=true
        ;;
      n)
        noti=true
        ;;
      d)
        fs=true
        od="${OPTARG:-$HOME/Screenshots}"
        ;;
      h)
        echo "$USAGE"
        exit 0
        ;;
      *)
        echo "$USAGE" >&2
        exit 1
        ;;
    esac
  done

  if $fs; then
    mkdir -p "$od" || {
      fatal "Failed to create directory: $od"
      exit 1
    }
  fi
}

notify_usr() {
  local status=$1
  local title body

  case $status in
    0)
      title="Screenshot taken"
      body="Screenshot "
      ;;
    1)
      title="Screenshot failed"
      body="Failed to take screenshot "
      ;;
    2)
      title="Screenshot cancelled"
      body="Screenshot was cancelled"
      notify-send -u low "$title" "$body"
      return
      ;;
  esac

  if $full; then
    body="${body}of all outputs"
  else
    body="${body}of selected area"
  fi

  local outputs=""
  if $clip && $fs && $stdout; then
    outputs="(clipboard, file, stdout)"
  elif $clip && $fs; then
    outputs="(clipboard & file)"
  elif $clip && $stdout; then
    outputs="(clipboard & stdout)"
  elif $fs && $stdout; then
    outputs="(file & stdout)"
  elif $clip; then
    outputs="(clipboard)"
  elif $fs; then
    outputs="(file)"
  elif $stdout; then
    outputs="(stdout)"
  fi

  body="${body} ${outputs}"
  notify-send -u low "$title" "$body"
}

take_scr() {
  local cmd="grim"
  local geometry=""

  if ! $full; then
    geometry=$(slurp 2>&1)
    local slurp_exit=$?

    if [ $slurp_exit -eq 1 ]; then
      $noti && notify_usr 2
      exit 0
    elif [ $slurp_exit -ne 0 ]; then
      fatal "Error running slurp: $geometry"
      $noti && notify_usr 1
      exit 1
    fi
  fi

  local filename="$od/Screenshot-$(date +"%Y-%m-%d_%H-%M-%S").png"

  if $stdout && $clip && $fs; then
    # All three outputs
    if $full; then
      grim - | tee "$filename" | tee >(wl-copy -t image/png) >/dev/null
    else
      grim -g "$geometry" - | tee "$filename" | tee >(wl-copy -t image/png) >/dev/null
    fi
  elif $stdout && $clip; then
    # stdout and clipboard
    if $full; then
      grim - | tee >(wl-copy -t image/png) >/dev/null
    else
      grim -g "$geometry" - | tee >(wl-copy -t image/png) >/dev/null
    fi
  elif $stdout && $fs; then
    # stdout and file
    if $full; then
      grim - | tee "$filename" >/dev/null
    else
      grim -g "$geometry" - | tee "$filename" >/dev/null
    fi
  elif $clip && $fs; then
    # clipboard and file
    if $full; then
      grim - | tee "$filename" | wl-copy -t image/png
    else
      grim -g "$geometry" - | tee "$filename" | wl-copy -t image/png
    fi
  elif $stdout; then
    # stdout only
    if $full; then
      grim -
    else
      grim -g "$geometry" -
    fi
  elif $clip; then
    # clipboard only
    if $full; then
      grim - | wl-copy -t image/png
    else
      grim -g "$geometry" - | wl-copy -t image/png
    fi
  elif $fs; then
    # file only
    if $full; then
      grim "$filename"
    else
      grim -g "$geometry" "$filename"
    fi
  fi

  return $?
}

parse_opts "$@"

if ! $clip && ! $fs && ! $stdout; then
  fatal "No output specified (use -c for clipboard, -o for stdout, or -d for file)"
  echo "$USAGE" >&2
  exit 1
fi

check_installed "grim"

if ! $full; then
  check_installed "slurp"
fi

if $clip; then
  check_installed "wl-copy"
fi

if $noti; then
  check_installed "notify-send"
fi

if take_scr; then
  $noti && notify_usr 0
  exit 0
else
  $noti && notify_usr 1
  exit 1
fi
