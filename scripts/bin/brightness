#!/usr/bin/env bash

step=5

print_help() {
  echo "Usage: brightness [OPTION] [AMOUNT]"
  echo "Args:"
  echo "--get		   Get the brightness"
  echo "--inc [AMOUNT] 	   Increase the brightness by the next arg or 5 if none provided"
  echo "--dec [AMOUNT] 	   Decrease the brightness by the next arg or 5 if none provided"
  echo "--set AMOUNT	   Set the brightness to the second arg"
  echo "-h, --help	   Show this menu"
}

get_brightness() {
  brightnessctl -m | cut -d, -f4 | tr -d '%'
}

change_brightness() {
  local p=$1
  local cur new

  cur=$(get_brightness)
  new=$((cur + p))

  ((new < 5)) && new=5
  ((new > 100)) && new=100

  brightnessctl set "${new}%"
}

case $1 in
  "--get")
    get_brightness
    ;;
  "--inc")
    amt=${2:-$step}
    if [[ ! "$2" =~ ^([0-9]|[1-9]|[0-9]|100)$ ]]; then
      echo "Error: --inc requires a numeric value (0-100)"
      exit 1
    fi
    change_brightness "$amt"
    ;;
  "--dec")
    amt=${2:-$step}
    if [[ ! "$2" =~ ^([0-9]|[1-9]|[0-9]|100)$ ]]; then
      echo "Error: --inc requires a numeric value (0-100)"
      exit 1
    fi
    change_brightness "-$amt"
    ;;
  "--set")
    if [[ ! "$2" =~ ^([0-9]|[1-9][0-9]|100)$ ]]; then
      echo "Error: --set requires a numeric value (0-100)"
      exit 1
    fi
    val=$2
    ((val < 5)) && val=5
    ((val > 100)) && val=100
    brightnessctl set "${val}%"
    ;;
  "-h" | "--help")
    print_help
    ;;
  *)
    print_help
    echo -e "\n\nCurrent brightness: $(get_brightness)"
    ;;
esac
