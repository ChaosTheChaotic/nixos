#!/usr/bin/env bash

step=5

print_help() {
  echo "Usage: volume [OPTIONS] [VALUE]"
  echo "Args:"
  echo "--get		   Get the current volume"
  echo "--inc [VALUE]  	   Increase volume by [VALUE] (default: 5)"
  echo "--dec [VALUE]  	   Decrease volume by [VALUE] (default: 5)"
  echo "--set [VALUE]	   Set the volume to VALUE (0-100)"
  echo "--mute	       	   Toggles the mute status"
  echo "--get-mic      	   Get the microphone volume"
  echo "--inc-mic [VALUE]  Increase mic volume by [VALUE] (default: 5)"
  echo "--dec-mic [VALUE]  Decrease mic volume by [VALUE] (default: 5)"
  echo "-h, --help	   Show this help menu"
}

is_num() { [[ "$1" =~ ^[0-9]+$ ]]; }

get_vol() {
  vol=$(pamixer --get-volume)
  echo "$vol"
}

inc_vol() {
  local amount=${1:-$step}
  if [ "$(pamixer --get-mute)" == "true" ]; then
    pamixer -u
  fi
  pamixer -i "$amount" --allow-boost --set-limit 150
}

dec_vol() {
  local amount=${1:-$step}
  if [ "$(pamixer --get-mute)" == "true" ]; then
    pamixer -u
  fi
  pamixer -d "$amount"
}

toggle_mute() {
  if [ "$(pamixer --get-mute)" == "false" ]; then
    pamixer -m
  elif [ "$(pamixer --get-mute)" == "true" ]; then
    pamixer -u
  fi
}

toggle_mic() {
  if [ "$(pamixer --default-source --get-mute)" == "false" ]; then
    pamixer --default-source -m
  elif [ "$(pamixer --default-source --get-mute)" == "true" ]; then
    pamixer -u --default-source
  fi
}

get_mic_vol() {
  vol=$(pamixer --default-source --get-volume)
  echo "$vol"
}

inc_mic_vol() {
  local amount=${1:-$step}
  if [ "$(pamixer --default-source --get-mute)" == "true" ]; then
    pamixer --default-source -u
  fi
  pamixer --default-source -i "$amount"
}

dec_mic_vol() {
  local amount=${1:-$step}
  if [ "$(pamixer --default-source --get-mute)" == "true" ]; then
    pamixer --default-source -u
  fi
  pamixer --default-source -d "$amount"
}

case $1 in
  "--get")     pamixer --get-volume ;;
  "--inc")     is_num "$2" || [[ -z "$2" ]] && inc_vol "${2:-$step}" || echo "Error: Not a number" ;;
  "--dec")     is_num "$2" || [[ -z "$2" ]] && dec_vol "${2:-$step}" || echo "Error: Not a number" ;;
  "--set")
      if [[ -n "$2" ]] && is_num "$2"; then
          pamixer --set-volume "$2"
      else
          echo "Error: Not a valid %"
      fi
      ;;
  "--mute")    pamixer -t ;;
  "--get-mic") pamixer --default-source --get-volume ;;
  "--inc-mic") is_num "$2" || [[ -z "$2" ]] && inc_mic_vol "${2:-$step}" || echo "Error: Not a number" ;;
  "--dec-mic") is_num "$2" || [[ -z "$2" ]] && dec_mic_vol "${2:-$step}" || echo "Error: Not a number" ;;
  "-h"|"--help") print_help ;;
  *)
    print_help
    echo -e "\n\nCurrent volume: $(get_vol)"
    ;;
esac
