#!/usr/bin/env bash

source "$UTIL_SCRIPT_DIR/check_installed.sh"
source "$UTIL_SCRIPT_DIR/nums.sh"
source "$UTIL_SCRIPT_DIR/err.sh"

step=5

print_help() {
  cat <<EOF
Usage: volume [OPTIONS] [VALUE]
Control audio volume.

Options:
  --get           Get current volume percentage
  --inc [VALUE]   Increase volume by VALUE (default: $step)
  --dec [VALUE]   Decrease volume by VALUE (default: $step)
  --set VALUE     Set volume to VALUE (0-150)
  --mute          Toggle mute status
  --get-mic       Get microphone volume
  --inc-mic [VALUE] Increase mic volume by VALUE (default: $step)
  --dec-mic [VALUE] Decrease mic volume by VALUE (default: $step)
  -h, --help      Show this help message
EOF
}

get_vol() {
  pamixer --get-volume
}

inc_vol() {
  local amount=${1:-$step}
  if [ "$(pamixer --get-mute)" == "true" ]; then
    pamixer -u
  fi
  pamixer -i "$amount" --allow-boost
}

dec_vol() {
  local amount=${1:-$step}
  if [ "$(pamixer --get-mute)" == "true" ]; then
    pamixer -u
  fi
  pamixer -d "$amount"
}

toggle_mute() {
  pamixer -t
}

get_mic_vol() {
  pamixer --default-source --get-volume
}

inc_mic_vol() {
  local amount=${1:-$step}
  if [ "$(pamixer --default-source --get-mute)" == "true" ]; then
    pamixer --default-source -u
  fi
  pamixer --default-source -i "$amount"
}

dec_mic_vol() {
  local amount=${1:-$step}
  if [ "$(pamixer --default-source --get-mute)" == "true" ]; then
    pamixer --default-source -u
  fi
  pamixer --default-source -d "$amount"
}

validate_volume() {
  local vol="$1"
  if ! is_num "$vol"; then
    fatal "Error: '$vol' is not a valid number"
    return 1
  fi
  if ((vol > 150)); then
    warn "Warning: Volume $vol exceeds typical maximum of 150%"
  fi
  return 0
}

check_installed "pamixer"

case "${1:-}" in
  "--get")
    get_vol
    ;;
  "--inc")
    amt="${2:-$step}"
    if ! validate_volume "$amt"; then
      exit 1
    fi
    inc_vol "$amt"
    info "Volume increased by ${amt}%"
    ;;
  "--dec")
    amt="${2:-$step}"
    if ! validate_volume "$amt"; then
      exit 1
    fi
    dec_vol "$amt"
    info "Volume decreased by ${amt}%"
    ;;
  "--set")
    if [ -z "$2" ]; then
      fatal "Error: --set requires a value"
      exit 1
    fi
    if ! validate_volume "$2"; then
      exit 1
    fi
    pamixer --set-volume "$2"
    info "Volume set to ${2}%"
    ;;
  "--mute")
    toggle_mute
    if [ "$(pamixer --get-mute)" == "true" ]; then
      info "Audio muted"
    else
      info "Audio unmuted"
    fi
    ;;
  "--get-mic")
    get_mic_vol
    ;;
  "--inc-mic")
    amt="${2:-$step}"
    if ! validate_volume "$amt"; then
      exit 1
    fi
    inc_mic_vol "$amt"
    info "Microphone volume increased by ${amt}%"
    ;;
  "--dec-mic")
    amt="${2:-$step}"
    if ! validate_volume "$amt"; then
      exit 1
    fi
    dec_mic_vol "$amt"
    info "Microphone volume decreased by ${amt}%"
    ;;
  "-h" | "--help")
    print_help
    ;;
  *)
    if [ -n "$1" ]; then
      warn "Unknown option: $1"
    fi
    print_help
    echo -e "\nCurrent volume: $(get_vol)%"
    if [ "$(pamixer --get-mute)" == "true" ]; then
      echo "Status: MUTED"
    fi
    ;;
esac
