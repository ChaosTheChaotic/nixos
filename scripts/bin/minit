#!/usr/bin/env bash

if [[ -f "$UTIL_SCRIPT_DIR/check_installed.sh" ]]; then
  source "$UTIL_SCRIPT_DIR/check_installed.sh"
else
  check_installed() {
    if ! command -v "$1" &>/dev/null; then
      fatal "Command $1 not installed" "1"
    fi
  } # Just incase of this being used elsewhere
fi

if [[ -f "$UTIL_SCRIPT_DIR/err.sh" ]]; then
  source "$UTIL_SCRIPT_DIR/err.sh"
else
  fatal() {
    echo "Error: $1"
    exit "${2:-1}"
  } # Just incase of this being used elsewhere
fi

# Defaults
VERBOSE=false
DEFAULT_LIB=false
DEFAULT_BIN=true
DEFAULT_CONF=false
DEFAULT_CC=false
DEFAULT_C=true
DEFAULT_CXX=false
DEFAULT_GIT=true
DEFAULT_TESTS=false
DEFAULT_PKG=false

PROJ_PATHS=()
PROJ_DATA=()

_add_project() {
  local path="$1"
  local data="$2"
  PROJ_PATHS+=("$path")
  PROJ_DATA+=("$data")
}

sedi() {
  local sed_script="$1"
  local file="$2"
  if [[ "$(uname -s)" =~ (Darwin|BSD) ]]; then
    sed -E -i '' "$sed_script" "$file"
  else
    sed -E -i "$sed_script" "$file"
  fi
}

print_help() {
  echo "Usage: $0 <mode> [options]"
  echo ""
  echo "Modes:"
  echo "  init, initialize, new    Create a new project structure"
  echo "  conf, configure          Manage dependencies for an existing project"
  echo ""
  echo "Init Options:"
  echo "  -v, --verbose            Enable verbose output"
  echo "  <path> [path-options]"
  echo "    -n, --name NAME        Custom project name"
  echo "    -l, --lib              Mark as library"
  echo "    -b, --no-bin           Disable binary"
  echo "    -c, --config           Generate configure script"
  echo "    --cc                   Build compile commands"
  echo "    --cxx		   Use CXX as well"
  echo "    --no-c		   Disable use of C entirely"
  echo "    --no-git		   Do not git init and generate other git files"
  echo "    --tests		   Enable tests for the project (you must configure your own testing library)"
  echo "    --pkg-config           Enable PkgConfig validation for dependencies"
  echo ""
  echo "Conf Options:"
  echo "  <path>                   Path to project root"
  echo "    --add <dep> [--static] [--public|--private]"
  echo "				   Add a dependency with specified linkage (defaults: bin: public libs: private)"
  echo "    --remove <dep>         Remove a dependency from the 'deps' interface"
}

parse_init_opts() {
  local current_path=""
  local name=""
  local is_lib=$DEFAULT_LIB
  local is_bin=$DEFAULT_BIN
  local has_conf=$DEFAULT_CONF
  local has_cc=$DEFAULT_CC
  local has_c=$DEFAULT_C
  local has_cxx=$DEFAULT_CXX
  local has_git=$DEFAULT_GIT
  local has_tests=$DEFAULT_TESTS
  local has_pkg=$DEFAULT_PKG

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v | --verbose)
        VERBOSE=true
        shift
        ;;
      -n | --name)
        [[ -z "$2" || "$2" == -* ]] && fatal "$1 requires a name argument" 1
        name="$2"
        shift 2
        ;;
      -l | --lib)
        is_lib=true
        shift
        ;;
      -b | --no-bin)
        is_bin=false
        shift
        ;;
      -c | --config)
        has_conf=true
        shift
        ;;
      --cc)
        has_cc=true
        shift
        ;;
      --cxx)
        has_cxx=true
        shift
        ;;
      --no-c)
        has_c=false
        shift
        ;;
      --no-git)
        has_git=false
        shift
        ;;
      --tests)
        has_tests=true
        shift
        ;;
      --pkg-config)
        has_pkg=true
        shift
        ;;
      --*)
        echo "Unknown option: $1" >&2
        print_help
        exit 1
        ;;
      *) # It's a path
        if [[ -n "$current_path" ]]; then
          # Save previous project
          local final_name="${name:-$(basename -- "$current_path")}"
          _add_project "$current_path" "$final_name|$is_lib|$is_bin|$has_conf|$has_cc|$has_cxx|$has_c|$has_git|$has_tests|$has_pkg"
          # Reset options for next path
          name=""
          is_lib=$DEFAULT_LIB
          is_bin=$DEFAULT_BIN
          has_conf=$DEFAULT_CONF
          has_cc=$DEFAULT_CC
          has_c=$DEFAULT_C
          has_cxx=$DEFAULT_CXX
          has_git=$DEFAULT_GIT
          has_tests=$DEFAULT_TESTS
          has_pkg=$DEFAULT_PKG
        fi
        current_path="$1"
        shift
        ;;
    esac
  done

  # Save the last project
  if [[ -n "$current_path" ]]; then
    local final_name="${name:-$(basename -- "$current_path")}"
    _add_project "$current_path" "$final_name|$is_lib|$is_bin|$has_conf|$has_cc|$has_cxx|$has_c|$has_git|$has_tests|$has_pkg"
  fi

  if [[ ${#PROJ_PATHS[@]} -eq 0 ]]; then
    fatal "No path specified. Usage: $0 init <path> [options]" 1
  fi
}

parse_conf() {
  local path="$1"
  shift
  local file="${path}/CMakeLists.txt"

  [[ ! -f "$file" ]] && fatal "No CMakeLists.txt found at $path" 1

  # Determine if the project uses PkgConfig
  local use_pkg=false
  grep -q "^[[:space:]]*find_package[[:space:]]*([[:space:]]*PkgConfig" "$file" && use_pkg=true

  # Determine default visibility based on project type
  local default_vis="private"
  grep -q "add_library[[:space:]]*(" "$file" && default_vis="public"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --add)
        local dep="$2"
        shift 2
        local visibility="$default_vis"
        local static_flag=""

        while [[ "$1" == --* ]]; do
          case "$1" in
            --public)
              visibility="public"
              shift
              ;;
            --private)
              visibility="private"
              shift
              ;;
            --static)
              static_flag="STATIC"
              shift
              ;;
            *) break ;;
          esac
        done

        # Escape dependency name for safe use in regex
        local dep_escaped
        dep_escaped=$(printf '%s\n' "$dep" | sed 's:[][\/.^$*&]:\\&:g')

        # Remove pkg_check_modules line
        sedi "/^[[:space:]]*pkg_check_modules[[:space:]]*\([^)]*PC_${dep_escaped}[^)]*\)/d" "$file"
        # Remove standard link lines
        sedi "/^[[:space:]]*target_link_libraries\(deps_(public|private) INTERFACE (PkgConfig::PC_)?${dep_escaped}\)/d" "$file"
        # Cleanup static blocks and loose matches
        sedi "/target_link_libraries\(deps_(public|private) INTERFACE .*${dep_escaped}.*\)/d" "$file"

        # Check if it is actually a pkg-config lib, or just a system lib
        local is_pkg_lib=false
        if [[ "$use_pkg" == true ]]; then
          if command -v pkg-config &>/dev/null && pkg-config --exists "$dep"; then
            is_pkg_lib=true
          fi
        fi

        if [[ "$is_pkg_lib" == true ]]; then
          # Add pkg_check_modules if not already present
          local pkg_line="pkg_check_modules(PC_${dep} REQUIRED ${static_flag} IMPORTED_TARGET ${dep})"
          if ! grep -Fq "pkg_check_modules(PC_${dep}" "$file"; then
            # Insert after find_package(PkgConfig) or at the end
            if grep -q "^[[:space:]]*find_package[[:space:]]*([[:space:]]*PkgConfig" "$file"; then
              cp "$file" "$file.tmp"
              awk '/^[[:space:]]*find_package[[:space:]]*\([[:space:]]*PkgConfig/ { print; print "'"$pkg_line"'"; next }1' "$file.tmp" >"$file"
              rm "$file.tmp"
            else
              echo "$pkg_line" >>"$file"
            fi
            echo "Added pkg_check_modules for $dep"
          fi

          # Add target_link_libraries for the interface library
          local link_line="target_link_libraries(deps_${visibility} INTERFACE PkgConfig::PC_${dep})"
          if ! grep -Fq "PkgConfig::PC_${dep}" "$file"; then
            echo "$link_line" >>"$file"
            echo "Linked $dep (visibility: $visibility)"
          else
            echo "Dependency $dep already linked (skipped)"
          fi
        else
          # Plain library linking (no pkg-config found, or project doesn't use it)
          local link_line
          if [[ -n "$static_flag" ]]; then
            # Add static linking flags (non‑MSVC only)
            link_line="if(NOT MSVC)\n  target_link_libraries(deps_${visibility} INTERFACE -Wl,-Bstatic ${dep} -Wl,-Bdynamic)\nelse()\n  target_link_libraries(deps_${visibility} INTERFACE ${dep})\nendif()"
            # Check if an equivalent line already exists
            if ! grep -q "target_link_libraries(deps_${visibility} INTERFACE .*${dep_escaped}" "$file"; then
              printf "%b\n" "$link_line" >>"$file"
              echo "Linked $dep (visibility: $visibility, static)"
            fi
          else
            link_line="target_link_libraries(deps_${visibility} INTERFACE ${dep})"
            # We use a looser grep check here to avoid duplicates
            if ! grep -q "target_link_libraries(deps_${visibility} INTERFACE .*${dep_escaped})" "$file"; then
              echo "$link_line" >>"$file"
              echo "Linked $dep (visibility: $visibility)"
            fi
          fi
        fi
        ;;
      --remove)
        local dep="$2"
        shift 2
        local dep_escaped
        # Escape the dependency name for safe use in the regex
        dep_escaped=$(printf '%s\n' "$dep" | sed 's:[][\/.^$*&]:\\&:g')

        # Check the dep exists
        if ! grep -qE "PC_${dep_escaped}|target_link_libraries\(deps_(public|private) INTERFACE .*${dep_escaped}" "$file"; then
          fatal "Dependency $dep not found in the CMakeLists" 2
        fi

        # Remove pkg_check_modules line (escapes literal parentheses)
        sedi "/^[[:space:]]*pkg_check_modules[[:space:]]*\([^)]*PC_${dep_escaped}[^)]*\)/d" "$file"

        # Remove standard link lines (handles both public/private and PkgConfig targets)
        sedi "/^[[:space:]]*target_link_libraries\(deps_(public|private) INTERFACE (PkgConfig::PC_)?${dep_escaped}\)/d" "$file"

        # Cleanup static blocks and loose matches (escapes literal parentheses)
        sedi "/target_link_libraries\(deps_(public|private) INTERFACE .*${dep_escaped}.*\)/d" "$file"

        echo "Removed $dep"
        ;;
      *)
        shift
        ;;
    esac
  done
}

create_project_struct() {
  local i path name is_lib is_bin has_conf has_cc has_cxx has_c has_git has_tests has_pkg
  for i in "${!PROJ_PATHS[@]}"; do
    path="${PROJ_PATHS[$i]}"
    IFS='|' read -r name is_lib is_bin has_conf has_cc has_cxx has_c has_git has_tests has_pkg <<<"${PROJ_DATA[$i]}"

    if [[ -z "$name" ]]; then
      echo "Error: Project name is empty for path: $path" >&2
      continue
    fi

    local parent_dir=$(dirname "$path")
    if [[ ! -w "$parent_dir" ]]; then
      echo "Cannot write to parent directory: $parent_dir" >&2
      continue
    fi

    [[ $VERBOSE == true ]] && echo "Processing $name at $path [Lib: $is_lib, Bin: $is_bin, Conf: $has_conf, CC: $has_cc, Git: $has_git, Tests: $has_tests, PkgConfig: $has_pkg]"

    mkdir -p "${path}/src/private"
    [[ $is_lib == true ]] && mkdir -p "${path}/include"

    if [[ -f "${path}/CMakeLists.txt" ]]; then
      if [[ ! -s "${path}/CMakeLists.txt" ]]; then
        echo "Warning: CMakeLists.txt exists but is empty. Overwriting." >&2
      else
        read -p "CMakeLists.txt already exists at $path. Overwrite? [y/N]: " -n 1 -r
        echo
        [[ ! $REPLY =~ ^[Yy]$ ]] && continue
      fi
    fi

    touch "${path}/CMakeLists.txt"

    if [[ "$has_conf" == true ]]; then
      touch "${path}/configure"
      chmod +x "${path}/configure"
    fi

    if [[ "$has_git" == true ]]; then
      [[ ! -d "${path}/.git" ]] && check_installed "git" && git init "${path}"
      touch "${path}/.gitignore"
      cat <<-EOF >>"${path}/.gitignore"
# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# minit additions
lib/
build/
.env
EOF
    fi

    if [[ $has_tests == true ]]; then
      mkdir -p "${path}/tests"
      touch "${path}/tests/CMakeLists.txt"
    fi
  done
}

write_cmakelists() {
  local i path name is_lib is_bin has_conf has_cc has_cxx has_c has_git has_tests has_pkg
  for i in "${!PROJ_PATHS[@]}"; do
    path="${PROJ_PATHS[$i]}"
    IFS='|' read -r name is_lib is_bin has_conf has_cc has_cxx has_c has_git has_tests has_pkg <<<"${PROJ_DATA[$i]}"

    [[ $VERBOSE == true ]] && echo "Writing CMakeLists for $path"
    local file="${path}/CMakeLists.txt"

    # Language selection
    local langs=""
    [[ $has_c == true ]] && langs+=" C"
    [[ $has_cxx == true ]] && langs+=" CXX"

    # Source glob patterns
    local glob_patterns=""
    [[ $has_c == true ]] && glob_patterns+=" \"src/*.c\""
    [[ $has_cxx == true ]] && glob_patterns+=" \"src/*.cpp\" \"src/*.cc\" \"src/*.cxx\""

    cat <<-EOF >"$file"
cmake_minimum_required(VERSION 3.10)
project($name VERSION 1.0 LANGUAGES$langs)

option(USE_CCACHE "Try to use ccache for faster builds" OFF)
option(USE_LTO "Use linktime optimizations if available" ON)
option(MARCH_NATIVE "Build library optimized for native arch" OFF)
option(DO_INSTALL "Try to install library after it is build" OFF)

$([[ "$has_pkg" == true ]] && echo "find_package(PkgConfig REQUIRED)")

add_library(settings INTERFACE)
add_library(deps_public INTERFACE)
add_library(deps_private INTERFACE)

target_include_directories(settings INTERFACE 
    \$<BUILD_INTERFACE:\${CMAKE_CURRENT_SOURCE_DIR}/src/private>
)

# Dependencies are added by the configuration script as separate
# target_link_libraries(deps_public ...) and target_link_libraries(deps_private ...)
# lines. Do not remove them manually.

find_program(CCACHE_PROGRAM ccache)
if(USE_CCACHE AND CCACHE_PROGRAM)
  set(CMAKE_C_COMPILER_LAUNCHER "\${CCACHE_PROGRAM}")
  set(CMAKE_CXX_COMPILER_LAUNCHER "\${CCACHE_PROGRAM}")
  message(STATUS "ccache is found and is being used")
elseif(USE_CCACHE)
  message(WARNING "ccache is enabled but not found.")
endif()

if(MSVC)
  target_compile_options(settings INTERFACE /W4)
else()
  target_compile_options(settings INTERFACE -Wall -Wextra -Wpedantic)
endif()

if(CMAKE_BUILD_TYPE STREQUAL "Release")
  if(MSVC)
    target_compile_options(settings INTERFACE /O2 /Ob2 /Oi /DNDEBUG)
  else()
    target_compile_options(settings INTERFACE -O3 -DNDEBUG)
  endif()
endif()

if(MARCH_NATIVE)
  if(MSVC)
    message(WARNING "MARCH_NATIVE is not supported by MSVC logic directly. Ignoring to prevent errors.")
  else()
    target_compile_options(settings INTERFACE -march=native -mtune=native)
    message(STATUS "Native architecture optimization enabled")
  endif()
endif()

set(ENABLE_LTO_ON_TARGETS FALSE)
if(USE_LTO)
  include(CheckIPOSupported)
  check_ipo_supported(RESULT ltos OUTPUT ltoerr)
  if(ltos)
    set(ENABLE_LTO_ON_TARGETS TRUE)
    message(STATUS "LTO enabled and supported")
  else()
    message(STATUS "LTO enabled but not supported: \${ltoerr}")
  endif()
endif()

file(GLOB_RECURSE SOURCES CONFIGURE_DEPENDS $glob_patterns)

EOF

    if [[ "$has_cc" == true ]]; then
      echo "set(CMAKE_EXPORT_COMPILE_COMMANDS ON)" >>"$file"
    fi

    cat <<-EOF >>"$file"
if(DO_INSTALL)
  include(GNUInstallDirs)
endif()

EOF

    if [[ "$is_lib" == true ]]; then
      cat <<-EOF >>"$file"
option(BUILD_SHARED "Build a shared library for the system" ON)
option(BUILD_STATIC "Build a static library for the system" ON)

if(BUILD_SHARED)
  add_library(${name} SHARED \${SOURCES})
  target_link_libraries(${name} 
    PUBLIC deps_public 
    PRIVATE settings deps_private
  )
  target_include_directories(${name} PUBLIC 
      \$<BUILD_INTERFACE:\${CMAKE_CURRENT_SOURCE_DIR}/include>
      \$<INSTALL_INTERFACE:include>
  )
  if(ENABLE_LTO_ON_TARGETS)
    set_target_properties(${name} PROPERTIES INTERPROCEDURAL_OPTIMIZATION TRUE)
  endif()
  if(DO_INSTALL)
    install(TARGETS ${name}
        EXPORT ${name}Targets
        LIBRARY DESTINATION \${CMAKE_INSTALL_LIBDIR}
        ARCHIVE DESTINATION \${CMAKE_INSTALL_LIBDIR}
        RUNTIME DESTINATION \${CMAKE_INSTALL_BINDIR}
    )
  endif()
endif()

if(BUILD_STATIC)
  set(STATIC_TARGET "${name}_static")
  if(NOT BUILD_SHARED)
    set(STATIC_TARGET "${name}")
  endif()
  add_library(\${STATIC_TARGET} STATIC \${SOURCES})
  target_link_libraries(\${STATIC_TARGET}
    PUBLIC deps_public
    PRIVATE settings deps_private
  )
  target_include_directories(\${STATIC_TARGET} PUBLIC 
      \$<BUILD_INTERFACE:\${CMAKE_CURRENT_SOURCE_DIR}/include>
      \$<INSTALL_INTERFACE:include>
  )
  set_target_properties(\${STATIC_TARGET} PROPERTIES OUTPUT_NAME "${name}")
  if(ENABLE_LTO_ON_TARGETS)
    set_target_properties(\${STATIC_TARGET} PROPERTIES INTERPROCEDURAL_OPTIMIZATION TRUE)
  endif()
  if(DO_INSTALL)
    install(TARGETS \${STATIC_TARGET}
        EXPORT ${name}Targets
        ARCHIVE DESTINATION \${CMAKE_INSTALL_LIBDIR}
    )
  endif()
endif()

if(DO_INSTALL)
  install(DIRECTORY include/ DESTINATION \${CMAKE_INSTALL_INCLUDEDIR})
endif()

EOF
    fi

    if [[ "$is_bin" == true ]]; then
      cat <<-EOF >>"$file"
add_executable(${name}_bin \${SOURCES})
target_link_libraries(${name}_bin 
  PUBLIC deps_public 
  PRIVATE settings deps_private
)
if(ENABLE_LTO_ON_TARGETS)
  set_target_properties(${name}_bin PROPERTIES INTERPROCEDURAL_OPTIMIZATION TRUE)
endif()
if(DO_INSTALL)
  install(TARGETS ${name}_bin
      RUNTIME DESTINATION \${CMAKE_INSTALL_BINDIR}
  )
endif()

EOF
    fi

    if [[ "$has_tests" == true ]]; then
      cat <<-EOF >>"$file"
enable_testing()
include(CTest)
if(BUILD_TESTING)
  add_subdirectory(tests)
endif()

EOF
      mkdir -p "${path}/tests"
      cat <<-EOF >"${path}/tests/CMakeLists.txt"
function(add_${name}_test TEST_NAME)
  add_executable(\${TEST_NAME} \${ARGN})
  target_link_libraries(\${TEST_NAME}
    deps_public
    settings
    deps_private
  )
  target_include_directories(\${TEST_NAME} PRIVATE 
    \${CMAKE_CURRENT_SOURCE_DIR}/../src
  )
  add_test(NAME \${TEST_NAME} COMMAND \${TEST_NAME})
endfunction()

EOF
    fi
  done
}

write_configure() {
  for i in "${!PROJ_PATHS[@]}"; do
    local path="${PROJ_PATHS[$i]}"
    IFS='|' read -r name is_lib is_bin has_conf has_cc has_cxx has_c has_git has_tests has_pkg <<<"${PROJ_DATA[$i]}"

    [[ "$has_conf" != true ]] && continue
    [[ $VERBOSE == true ]] && echo "Writing configure script for: $path"

    local file="${path}/configure"
    # Generate help text from CMakeLists.txt options
    local cmake_options=""
    if [[ -f "${path}/CMakeLists.txt" ]]; then
      while IFS= read -r line; do
        if [[ "$line" =~ option[[:space:]]*\(([^[:space:]]+)[[:space:]]+\"([^\"]+)\"[[:space:]]+([^[:space:]]+)\) ]]; then
          cmake_options+="  -D${BASH_REMATCH[1]}=[ON|OFF]    ${BASH_REMATCH[2]} (default: ${BASH_REMATCH[3]})"$'\n'
        elif [[ "$line" =~ option[[:space:]]*\(([^[:space:]]+)[[:space:]]+\"([^\"]+)\"\) ]]; then
          cmake_options+="  -D${BASH_REMATCH[1]}=[ON|OFF]    ${BASH_REMATCH[2]}"$'\n'
        fi
      done <"${path}/CMakeLists.txt"
    else
      # Fallback
      cmake_options="  -DUSE_CCACHE=[ON|OFF]    Try to use ccache for faster builds (default: OFF)"$'\n'
      cmake_options+="  -DUSE_LTO=[ON|OFF]       Use linktime optimizations if available (default: ON)"$'\n'
      cmake_options+="  -DMARCH_NATIVE=[ON|OFF]  Build library optimized for native arch (default: OFF)"$'\n'
      cmake_options+="  -DDO_INSTALL=[ON|OFF]    Try to install library after it is build (default: OFF)"$'\n'
      [[ "$is_lib" == true ]] && cmake_options+="  -DBUILD_SHARED=[ON|OFF]    Build a shared library (default: ON)"$'\n'
      [[ "$is_lib" == true ]] && cmake_options+="  -DBUILD_STATIC=[ON|OFF]    Build a static library (default: ON)"$'\n'
    fi

    cat <<-EOF >"$file"
#!/usr/bin/env bash
# Generated configure wrapper for $name
set -euo pipefail

SRC_DIR="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="\${BUILD_DIR:-"\$SRC_DIR/build"}"
GEN=""
CLEAN=false
CMAKE_EXTRA_ARGS=()

show_help() {
    cat <<EOH
Configure script for $name

Usage: \$0 [OPTIONS] -- [CMAKE_OPTIONS]

Options:
  -h, --help            Show this help message
  -b, --build-dir DIR   Set build directory (default: ./build)
  -c, --clean           Clean the build dir if it already exists
  -g, --generator GEN   Specify CMake generator (e.g., Ninja, Unix Makefiles)
  --no-ninja            Don't use Ninja even if available

CMake Options (can be passed after --):
  -DCMAKE_BUILD_TYPE=[Release|Debug]
$(echo -n "$cmake_options")
EOH
}

if ! command -v cmake &>/dev/null; then
    echo "Error: cmake is not installed." >&2
    exit 1
fi

while [[ \$# -gt 0 ]]; do
    case \$1 in
        -h|--help)      show_help; exit 0 ;;
	-b|--build-dir)
	  [[ -z "$2" ]] && echo "Error: -b requires an argument" && exit 1
	  BUILD_DIR="$2"
	  shift 2
	  ;;
        -c|--clean)     CLEAN=true; shift ;;
        -g|--generator) GEN="\$2"; shift 2 ;;
        --no-ninja)     GEN="Unix Makefiles"; shift ;;
        --)             shift; CMAKE_EXTRA_ARGS+=("\$@"); break ;;
        -D*)            CMAKE_EXTRA_ARGS+=("\$1"); shift ;;
        *)              echo "Unknown option: \$1" >&2; show_help; exit 1 ;;
    esac
done

if [[ "\$CLEAN" == true && -n "\$BUILD_DIR" && "\$BUILD_DIR" != "/" ]]; then
    echo "Cleaning build directory: \$BUILD_DIR"
    rm -rf "\$BUILD_DIR"
else
  echo "Refusing to clean dangerous dir"
fi

if [[ -z "\$GEN" ]] && command -v ninja &>/dev/null; then
    GEN="Ninja"
fi

CMAKE_CMD=("cmake" "-S" "\$SRC_DIR" "-B" "\$BUILD_DIR")
[[ -n "\$GEN" ]] && CMAKE_CMD+=("-G" "\$GEN")
[[ \${#CMAKE_EXTRA_ARGS[@]} -gt 0 ]] && CMAKE_CMD+=("\${CMAKE_EXTRA_ARGS[@]}")

echo "=== Configuring $name ==="
echo "Build Dir: \$BUILD_DIR"
echo "Generator: \${GEN:-Default}"
echo "Command:   \${CMAKE_CMD[*]}"
echo "========================"

if "\${CMAKE_CMD[@]}"; then
    echo "Configuration successful. Run 'cmake --build \$BUILD_DIR' to compile."
else
    exit 1
fi
EOF
    chmod +x "$file"
  done
}

if [[ $# -lt 1 ]]; then
  print_help
  exit 0
fi

MODE="$1"
shift

case "$MODE" in
  init | initialize | new)
    parse_init_opts "$@"
    create_project_struct
    write_cmakelists
    write_configure
    ;;
  conf | configure)
    conf_path="."

    if [[ $# -gt 0 && "$1" != -* ]]; then
      conf_path="$1"
      shift
    fi

    if [[ ! -f "${conf_path}/CMakeLists.txt" ]]; then
      echo "Error: No CMakeLists.txt found at '$conf_path'" >&2
      exit 1
      fatal "No CMakeLists.txt found at '$conf_path'" 1
    fi

    parse_conf "$conf_path" "$@"
    ;;
  -h | --help)
    print_help
    exit 0
    ;;
  *)
    echo "Unknown mode: $MODE"
    print_help
    exit 1
    ;;
esac
